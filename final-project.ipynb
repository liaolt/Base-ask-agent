available = {"query_mysql": query_mysql, "calculator": calculator}
available["search_docs"] = lambda question: "\n".join(
    col.query(query_embeddings=embed([question]), n_results=2)["documents"][0])

chunks = [doc[i:i+120] for i in range(0, len(doc), 120)]
print(f"切成 {len(chunks)} 片")

cc = chromadb.Client()
col = cc.get_or_create_collection("mydocs")
col.add(documents=chunks,
        ids=[f"c{i}" for i in range(len(chunks))],
        embeddings=embed(chunks))

def ask_agent(question):
    messages = [
        {"role": "system", "content": "你是数据助手。遇到数据问题先查数据库，需要算数用计算器，最后用中文总结回答。"},
        {"role": "user", "content": question}]
    for _ in range(8):
        resp = client.chat.completions.create(
            model="mimo-v2.6-pro", messages=messages, tools=tools,extra_body={"thinking": {"type": "disabled"}})
        msg = resp.choices[0].message
        if msg.tool_calls:
            messages.append(msg)
            for tc in msg.tool_calls:
                args = json.loads(tc.function.arguments)
                print(f">>> 调用 {tc.function.name}({args})")
                result = available[tc.function.name](**args)
                messages.append({"role": "tool",
                                 "tool_call_id": tc.id, "content": result})
        else:
            return msg.content
    return "步数超限"

def rag_answer(question):
    hits = col.query(query_embeddings=embed([question]), n_results=2)
    context = "\n".join(hits["documents"][0])
    print(f"【检索到的资料】\n{context}\n")
    prompt = f"仅根据以下资料回答，资料里没有的信息就回答'不知道'。\n资料：{context}\n\n问题：{question}"
    resp = client.chat.completions.create(
        model="mimo-v2.6-pro",
        messages=[{"role": "user", "content": prompt}])
    return resp.choices[0].message.content

