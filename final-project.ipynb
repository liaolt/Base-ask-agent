def calculator(expression):
    try:
        return str(eval(expression))
    except Exception as e:
        return f"计算出错: {e}"

def query_mysql(sql):
    if not sql.strip().lower().startswith("select"):
        return "错误: 只允许SELECT查询"
    conn = pymysql.connect(
        host="localhost", user="root",
        password="@Letian531935569", database="test", charset="utf8mb4")
    try:
        with conn.cursor() as cur:
            cur.execute(sql)
            return json.dumps(cur.fetchall(), ensure_ascii=False, default=str)
    finally:
        conn.close()

def embed(texts):
    resp = sf.embeddings.create(model="BAAI/bge-m3", input=texts)
    return [d.embedding for d in resp.data]

doc = """倪多多的简历。河南大学电气信息工程学院，人工智能专业。
